    "@types/node": "^22.19.3",
    "@types/react": "~19.1.17",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.2",
    "eslint-config-expo": "~10.0.0",
    "prettier": "^3.7.4",
    "typescript": "~5.9.3",
